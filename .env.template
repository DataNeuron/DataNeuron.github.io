# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# GitHub Personal Access Token
# Required for: Fetching pinned repositories via GraphQL API
# Scopes needed: public_repo (read-only access to public repositories)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# GitHub Username
# Your GitHub username for fetching pinned repositories
GITHUB_USERNAME=DataNeuron

# For GitHub Actions (use repository secret instead):
# Go to repository Settings → Secrets and variables → Actions
# Create secret: PORTFOLIO_SYNC_TOKEN=<your_token>
